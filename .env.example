# Port local (ignoré par o2switch/Passenger, mais utile en dev)
PORT=3000


# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=urlr
MYSQL_PASSWORD=changeme
MYSQL_DB=urlr


# Sécurité
ADMIN_TOKEN=change-this-admin-token
SESSION_SECRET=change-this-session-secret


# Domaine public (utilisé pour générer les QR Codes / URLs courtes)
PUBLIC_BASE_URL=https://short.example.com

# SMTP configuration for password reset emails (e.g. o2switch)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=contact@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM="ShortR" <contact@yourdomain.com>
